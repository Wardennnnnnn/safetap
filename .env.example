PORT=3000
HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=safetap
DB_PASSWORD=replace-me
DB_NAME=safetap
DB_SSL=0
# Cloud MySQL: DB_SSL=1 and the provider CA certificate file.
# Render secret file path: /etc/secrets/aiven-ca.pem
DB_SSL_CA_FILE=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-at-least-12-characters
# Enable only behind your trusted HTTPS reverse proxy:
TRUST_PROXY=0
COOKIE_SECURE=0
